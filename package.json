{
  "name": "tienda-api",
  "version": "1.0.0",
  "description": "API de ejemplo para la Práctica Calificada 02 - Despliegue de Aplicaciones (ESAN)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:cov": "node --test --experimental-test-coverage",
    "pipeline": "node -e \"import('node:child_process').then(({spawnSync})=>{const r=spawnSync('npm',['test'],{stdio:'inherit',shell:true});const estado=r.status===0?'exito':'error';const n=spawnSync('node',['notificar.mjs',estado],{stdio:'inherit',shell:true});process.exit(r.status!==0?r.status:(n.status??0));})\""
  },
  "license": "UNLICENSED"
}
